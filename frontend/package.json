{
  "name": "resto-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:i18n": "node scripts/verify-i18n.mjs && node scripts/verify-i18n-usage.mjs",
    "verify:i18n-usage": "node scripts/verify-i18n-usage.mjs",
    "lint": "eslint \"src/**/*.{js,vue}\" --max-warnings=0",
    "format": "prettier -c \"src/**/*.{js,vue,css}\"",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:critical": "playwright test tests/e2e/critical-saas-flow.spec.js",
    "e2e:mobile": "playwright test tests/e2e/mobile-breakpoint-regression.spec.js",
    "e2e:install": "playwright install chromium"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "brace-expansion@1": "1.1.16",
    "brace-expansion@2": "2.1.3",
    "brace-expansion@5": "5.0.8",
    "fast-uri": "3.1.7",
    "js-yaml": "4.3.0",
    "nanoid": "^3.3.17",
    "postcss-selector-parser": "6.1.4"
  },
  "dependencies": {
    "@sentry/vue": "^10.71.0",
    "axios": "1.20.0",
    "leaflet": "^1.9.4",
    "pinia": "4.0.3",
    "qrcode": "^1.5.4",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.0",
    "@pinia/testing": "^2.0.1",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/eslint-config-prettier": "9.0.0",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "10.5.4",
    "eslint": "10.9.1",
    "eslint-plugin-vue": "10.10.0",
    "globals": "16.5.0",
    "jsdom": "^30.0.1",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "tailwindcss": "3.4.13",
    "vite": "8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "4.1.11",
    "vue-eslint-parser": "10.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}
